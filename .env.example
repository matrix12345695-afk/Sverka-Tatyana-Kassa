# Скопируйте этот файл в .env и заполните. Файл .env никому не пересылайте.
# Для GitHub Actions эти значения задаются в Settings → Secrets and variables → Actions, а НЕ здесь.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Кому слать отчёты: ID чатов через запятую (узнать — отправить боту /id)
ALLOWED_CHAT_IDS=

# Billz: токен входа (см. README)
BILLZ_ACCESS_TOKEN=
# Если когда-нибудь появится секретный ключ API — впишите его сюда, токен станет не нужен.
BILLZ_SECRET_TOKEN=
BILLZ_API_URL=https://api-admin.billz.ai
# ID компании в Billz (поле company_id)
BILLZ_COMPANY_ID=
# Поддомен Billz (для ссылок на продажи): https://<поддомен>.billz.ai
BILLZ_SUBDOMAIN=

# Google-таблица: ID из адреса docs.google.com/spreadsheets/d/<ID>/edit
SPREADSHEET_ID=
# Ключ сервисного аккаунта Google (файл JSON рядом с bot.py)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

TIMEZONE=Asia/Tashkent
DAILY_REPORT_TIME=21:00
